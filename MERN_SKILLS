// src/seed/seedProvider.js
const usersData = require('./users.json');
const logger = require('../utils/logger');

class SeedProvider {
  async getAllUsers(page = 1, limit = 20) {
    try {
      const skip = (page - 1) * limit;
      const users = usersData.slice(skip, skip + limit);
      return {
        users,
        total: usersData.length,
        page,
        limit
      };
    } catch(error) {
      logger.error('Seed provider error in getAllUsers', { error });
      throw error;
    }
  }

  async getUserById(id) {
    try {
      const user = usersData.find(u => u._id === id);
      if (!user) throw new Error('User not found in seed');
      return user;
    } catch(error) {
      logger.error('Seed provider error in getUserById', { error });
      throw error;
    }
  }
}

module.exports = new SeedProvider();
