// src/utils/logger.js
const fs = require('fs');
const path = require('path');

const logsDir = path.join(__dirname, '../logs');
if (!fs.existsSync(logsDir)) {
  fs.mkdirSync(logsDir, { recursive: true });
}

const timestamp = () => new Date().toISOString();

const formatLog = (level, message, metadata = {}) => {
  return JSON.stringify({
    timestamp: timestamp(),
    level,
    message,
    metadata,
    process: process.pid,
    env: process.env.NODE_ENV
  });
};

const logger = {
  info: (message, metadata = {}) => {
    const log = formatLog('INFO', message, metadata);
    console.log(log);
    if (process.env.NODE_ENV === 'production') {
      fs.appendFileSync(
        path.join(logsDir, 'info.log'),
        log + '\n'
      );
    }
  },

  error: (message, metadata = {}) => {
    const log = formatLog('ERROR', message, metadata);
    console.error(log);
    fs.appendFileSync(
      path.join(logsDir, 'error.log'),
      log + '\n'
    );
  },

  warn: (message, metadata = {}) => {
    const log = formatLog('WARN', message, metadata);
    console.warn(log);
  },

  debug: (message, metadata = {}) => {
    if (process.env.DEBUG === 'true') {
      const log = formatLog('DEBUG', message, metadata);
      console.log(log);
    }
  }
};

module.exports = logger;
