#### services/userService.js

```javascript
// src/services/userService.js
const userQueries = require('../queries/userQueries');
const cache = require('../config/redis');
const seedProvider = require('../seed/seedProvider');
const logger = require('../utils/logger');

class UserService {
  async getUserById(id) {
    try {
      // 1. Check cache first
      const cacheKey = `user:${id}`;
      let user = await cache.get(cacheKey);
      if (user) {
        logger.debug('User from cache', { id });
        return user;
      }

      // 2. Try database
      try {
        user = await userQueries.getById(id);
      } catch(error) {
        // 3. Fallback to seed
        logger.warn('DB unavailable, using seed data', { id });
        user = await seedProvider.getUserById(id);
      }

      // 4. Cache the result
      await cache.set(cacheKey, user, 3600);

      return user;
    } catch(error) {
      logger.error('Error in getUserById', { id, error });
      throw error;
    }
  }

  async getAllUsers(filters = {}, page = 1, limit = 20) {
    try {
      let result;

      try {
        result = await userQueries.getAll(filters, page, limit);
      } catch(error) {
        logger.warn('DB unavailable, using seed data');
        result = await seedProvider.getAllUsers(page, limit);
      }

      return result;
    } catch(error) {
      logger.error('Error in getAllUsers', { error });
      throw error;
    }
  }

  async createUser(userData) {
    try {
      const existingUser = await userQueries.getByEmail(userData.email);
      if (existingUser) {
        throw new Error('Email already registered');
      }

      const user = await userQueries.create(userData);
      
      // Invalidate cache
      await cache.delete('users:all');

      logger.info('User created successfully', { userId: user._id });
      return user;
    } catch(error) {
      logger.error('Error in createUser', { error });
      throw error;
    }
  }

  async updateUser(id, updateData) {
    try {
      const user = await userQueries.updateById(id, updateData);
      
      // Invalidate caches
      await cache.delete(`user:${id}`);
      await cache.delete('users:all');

      logger.info('User updated successfully', { userId: id });
      return user;
    } catch(error) {
      logger.error('Error in updateUser', { error });
      throw error;
    }
  }

  async deleteUser(id) {
    try {
      await userQueries.deleteById(id);
      
      // Invalidate caches
      await cache.delete(`user:${id}`);
      await cache.delete('users:all');

      logger.info('User deleted successfully', { userId: id });
      return true;
    } catch(error) {
      logger.error('Error in deleteUser', { error });
      throw error;
    }
  }
}

module.exports = new UserService();
