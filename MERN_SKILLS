describe('UserService', () => {
  beforeEach(() => {
    jest.clearAllMocks();
  });

  test('getUserById should return cached user if available', async () => {
    const userId = '123';
    const mockUser = { _id: userId, name: 'Test' };
    
    cache.get.mockResolvedValueOnce(mockUser);
    
    const result = await UserService.getUserById(userId);
    
    expect(cache.get).toHaveBeenCalledWith(`user:${userId}`);
    expect(userQueries.getById).not.toHaveBeenCalled();
    expect(result).toEqual(mockUser);
  });

  test('getUserById should fall back to database if cache miss', async () => {
    const userId = '123';
    const mockUser = { _id: userId, name: 'Test' };
    
    cache.get.mockResolvedValueOnce(null);
    userQueries.getById.mockResolvedValueOnce(mockUser);
    cache.set.mockResolvedValueOnce(true);
    
    const result = await UserService.getUserById(userId);
    
    expect(cache.get).toHaveBeenCalledWith(`user:${userId}`);
    expect(userQueries.getById).toHaveBeenCalledWith(userId);
    expect(cache.set).toHaveBeenCalled();
    expect(result).toEqual(mockUser);
  });
});
