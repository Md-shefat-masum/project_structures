## 📚 Layer-Specific Rules Checklist

### Controller Layer
```javascript
// ✅ DO
async getUser(req, res) {
  try {
    const user = await userService.getUser(req.params.id);
    return response.success(res, user);
  } catch(error) {
    return response.error(res, error.message);
  }
}

// ❌ DON'T
async getUser(req, res) {
  // Direct DB call
  const user = await User.findById(req.params.id);
  
  // Complex logic
  const processed = user.map(u => ({ ...u, role: 'admin' }));
  
  // Direct response
  return res.json({ data: processed });
}
```

### Service Layer
```javascript
// ✅ DO
async getUser(id) {
  // Check cache
  let user = await cache.get(`user:${id}`);
  if (user) return user;
  
  // Try DB
  try {
    user = await userQuery.getById(id);
  } catch(err) {
    // Fallback to seed
    user = await seedProvider.getUser(id);
  }
  
  // Cache result
  await cache.set(`user:${id}`, user, 3600);
  return user;
}

// ❌ DON'T
async getUser(id) {
  // Direct DB call
  return User.findById(id);
}
```

### Query Layer
```javascript
// ✅ DO
async getById(id) {
  try {
    const user = await User.findById(id);
    if (!user) throw new Error('Not found');
    return user;
  } catch(error) {
    logger.error('Query failed', { id, error });
    throw error;
  }
}

// ❌ DON'T
async getById(id) {
  // Throw business logic error
  const user = await User.findById(id);
  if (user.role === 'admin') {
    throw new ForbiddenError('Cannot access admin');
  }
  return user;
}
```

### Route Layer
```javascript
// ✅ DO
router.get('/:id', authenticate, controller.getUser);

router.post(
  '/',
  authenticate,
  validators.validate(userSchema),
  controller.createUser
);

// ❌ DON'T
router.get('/:id', (req, res) => {
  const user = User.findById(req.params.id);
  res.json(user);
});
```

