## 📈 Performance Optimization

### 1. Database Query Optimization

```javascript
// src/queries/optimizedQueries.js
class OptimizedQueries {
  // Bad: N+1 problem
  async getTeamWithMembersBAD(teamId) {
    const team = await Team.findById(teamId);
    team.members = await Promise.all(
      team.memberIds.map(id => User.findById(id))
    );
    return team;
  }

  // Good: Single query with population
  async getTeamWithMembers(teamId) {
    return Team.findById(teamId).populate('memberIds');
  }

  // Bad: Fetching too much data
  async getAllUsersBAD() {
    return User.find(); // Returns all fields
  }

  // Good: Select only needed fields
  async getAllUsers() {
    return User.find().select('name email role');
  }

  // Bad: No pagination
  async getPostsBAD(userId) {
    return Post.find({ userId });
  }

  // Good: Paginated with limit
  async getPosts(userId, page = 1, limit = 20) {
    const skip = (page - 1) * limit;
    return Post.find({ userId })
      .skip(skip)
      .limit(limit)
      .sort({ createdAt: -1 });
  }

  // Good: Aggregation for complex queries
  async getUserStatistics(userId) {
    return User.aggregate([
      { $match: { _id: userId } },
      {
        $lookup: {
          from: 'posts',
          localField: '_id',
          foreignField: 'userId',
          as: 'posts'
        }
      },
      {
        $group: {
          _id: '$_id',
          name: { $first: '$name' },
          postCount: { $size: '$posts' },
          totalLikes: { $sum: '$posts.likeCount' }
        }
      }
    ]);
  }
}
```

