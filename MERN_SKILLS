// src/queues/mailQueue.js
const Queue = require('bull');
const logger = require('../utils/logger');

const mailQueue = new Queue('mail', {
  redis: { host: 'localhost', port: 6379 }
});

// Producer
async function sendWelcomeEmail(userId) {
  await mailQueue.add(
    { userId },
    { delay: 1000, attempts: 3, backoff: 'exponential' }
  );
}

// Consumer (Worker)
mailQueue.process(async (job) => {
  const { userId } = job.data;
  logger.info('Processing mail job', { userId });
  
  try {
    const user = await userService.getUser(userId);
    await emailService.sendWelcome(user.email);
    logger.info('Email sent successfully', { userId });
  } catch(error) {
    logger.error('Email job failed', { userId, error });
    throw error; // Will retry
  }
});

// In service layer
async function registerUser(userData) {
  const user = await userService.create(userData);
  
  // Queue the email without waiting
  await sendWelcomeEmail(user._id);
  
  return user;
}
