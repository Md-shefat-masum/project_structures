### 11. Middleware Layer

#### middlewares/errorHandler.js

```javascript
// src/middlewares/errorHandler.js
const logger = require('../utils/logger');
const response = require('../utils/response');

const errorHandler = (err, req, res, next) => {
  logger.error('Unhandled Error', {
    message: err.message,
    stack: err.stack,
    path: req.path,
    method: req.method
  });

  // Mongoose validation error
  if (err.name === 'ValidationError') {
    const messages = Object.values(err.errors).map(e => e.message);
    return response.error(res, 'Validation failed', 400, messages);
  }

  // Duplicate key error
  if (err.code === 11000) {
    return response.error(res, 'Duplicate field value', 400);
  }

  // JWT errors
  if (err.name === 'JsonWebTokenError') {
    return response.error(res, 'Invalid token', 401);
  }

  // Default error
  const status = err.status || 500;
  const message = err.message || 'Internal server error';
  return response.error(res, message, status);
};

module.exports = errorHandler;
```

#### middlewares/authMiddleware.js

```javascript
// src/middlewares/authMiddleware.js
const jwt = require('jsonwebtoken');
const logger = require('../utils/logger');
const response = require('../utils/response');

const authMiddleware = {
  authenticate: (req, res, next) => {
    try {
      const token = req.headers.authorization?.split(' ')[1];
      if (!token) {
        return response.error(res, 'No token provided', 401);
      }

      const decoded = jwt.verify(token, process.env.JWT_SECRET);
      req.user = decoded;
      next();
    } catch(error) {
      logger.error('Authentication failed', { error: error.message });
      return response.error(res, 'Invalid or expired token', 401);
    }
  },

  authorize: (...roles) => {
    return (req, res, next) => {
      if (!req.user) {
        return response.error(res, 'Not authenticated', 401);
      }

      if (!roles.includes(req.user.role)) {
        return response.error(res, 'Insufficient permissions', 403);
      }

      next();
    };
  }
};

module.exports = authMiddleware;
```

